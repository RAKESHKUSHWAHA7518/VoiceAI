{
  "name": "voiceai-backend",
  "version": "1.0.0",
  "description": "Production-grade Real-Time Multimodal Voice Agent Platform",
  "main": "dist/server/src/app.js",
  "scripts": {
    "start": "node dist/server/src/app.js",
    "dev": "tsx watch server/src/app.ts",
    "test": "jest --no-coverage --forceExit",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx scripts/check-mongodb.ts",
    "db:test": "tsx scripts/test-mongodb.ts",
    "lint": "eslint server/src/",
    "lint:fix": "eslint server/src/ --fix",
    "build": "tsc",
    "start:prod": "NODE_ENV=production node dist/server/src/app.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "tunnel": "node scripts/start-carrier-tunnel.js",
    "benchmark": "node scripts/benchmark-latency.js"
  },
  "keywords": [
    "voice-ai",
    "real-time",
    "websocket",
    "asr",
    "tts",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.10",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "onnxruntime-node": "^1.30.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

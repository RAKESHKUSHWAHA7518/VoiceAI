# VoiceAI - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# REQUIRED - Core API Keys (at least one of each category)
# ============================================

# ASR (Speech-to-Text)
DEEPGRAM_API_KEY=your_deepgram_key_here

# LLM (Large Language Model)
OPENAI_API_KEY=your_openai_key_here

# TTS (Text-to-Speech)
CARTESIA_API_KEY=your_cartesia_key_here

# ============================================
# OPTIONAL - Fallback / Alternative Providers
# ============================================

# Alternative TTS
ELEVENLABS_API_KEY=

# Alternative LLM (free tier available)
GROQ_API_KEY=

# Google Gemini (free tier available)
GEMINI_API_KEY=

# ============================================
# OPTIONAL - Infrastructure
# ============================================

# MongoDB Atlas: leave empty to use local JSON storage.
MONGODB_URI=
# Optional override; otherwise uses the URI database, or voiceai if omitted.
MONGODB_DB_NAME=voiceai

# LiveKit (WebRTC transport)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Twilio (SIP/PSTN)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SIP_WEBHOOK_URL=

# Langfuse (Observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================
# Database & Cache
# ============================================
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://voiceai:voiceai@localhost:5432/voiceai

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# Server
# ============================================
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS
CORS_ORIGIN=*

# ============================================
# VAD Settings
# ============================================
VAD_THRESHOLD=0.6
VAD_SOS_DEBOUNCE_MS=120
VAD_EOS_TIMEOUT_MS=500

# ============================================
# LLM Settings
# ============================================
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ============================================
# TTS Settings
# ============================================
TTS_PROVIDER=cartesia
TTS_VOICE_ID=
TTS_SAMPLE_RATE=24000

# ============================================
# Audio Settings
# ============================================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=30

# ============================================
# VAD Settings
# ============================================
VAD_THRESHOLD=0.6
VAD_SOS_DEBOUNCE_MS=120
VAD_EOS_TIMEOUT_MS=500

# ============================================
# LLM Settings
# ============================================
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ============================================
# TTS Settings
# ============================================
TTS_PROVIDER=cartesia
TTS_VOICE_ID=
TTS_SAMPLE_RATE=24000

# ============================================
# ASR Settings
# ============================================
ASR_PROVIDER=deepgram
ASR_MODEL=nova-2
ASR_LANGUAGE=en

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Private workspace demo defaults (no model requests in demo mode)
VOICEAI_RUNTIME_MODE=demo
VOICEAI_LEGACY_DEMO=false
VOICEAI_PUBLIC_LIVE=false
# Optional absolute storage directory; defaults to server/data under project root
VOICEAI_DATA_DIR=

# cloud: authenticated voice tests use Deepgram streaming and Cartesia speech; consumes provider credits.
VOICEAI_SPEECH_MODE=browser
DEEPGRAM_MODEL=nova-3
CARTESIA_MODEL=sonic-3.6

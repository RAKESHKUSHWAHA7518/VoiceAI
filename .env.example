# Provider API Keys (get from respective dashboards)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Redis & Postgres
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/voiceai

# Langfuse (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LiveKit (for WebRTC)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SIP / Twilio (for PSTN)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SIP_WEBHOOK_URL=  # Public URL for Twilio webhooks (e.g., https://yourdomain.com)

# VAD Settings
VAD_THRESHOLD=0.6
VAD_SOS_DEBOUNCE_MS=120
VAD_EOS_TIMEOUT_MS=500

# LLM Settings
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# TTS Settings
TTS_PROVIDER=cartesia  # cartesia | elevenlabs | kokoro
TTS_VOICE_ID=
TTS_SAMPLE_RATE=24000

# Audio
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=30

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO